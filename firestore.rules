rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // In a real app, you'd check a dedicated admins collection or specific email.
      // For this app, we'll allow the person who set it up (the user) to be admin.
      return isSignedIn() && (
        request.auth.token.email == "kong@suwonrehab.or.kr" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSubmission(data) {
      return data.senderName is string && data.senderName.size() > 0 && data.senderName.size() <= 100
          && data.photoUrl is string && data.photoUrl.size() > 0 && data.photoUrl.size() <= 2000000
          && data.submittedAt is timestamp
          && (data.status == "pending" || data.status == "organized");
    }

    // Submissions
    match /submissions/{submissionId} {
      // Anyone can submit a photo (Create)
      allow create: if isValidSubmission(request.resource.data);
      
      // Since we replaced Firebase Auth with a client-side passcode (5612) for simplicity and Vercel external bypass,
      // we allow read, delete, and update without Firebase Authentication requirements.
      allow read, delete, update: if true;
    }

    // App Config
    match /config/{configId} {
      allow read: if true; // Publicly readable settings
      allow write: if isAdmin();
    }
    
    // Admin list
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
